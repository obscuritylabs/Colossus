{
  "openapi": "3.1.0",
  "info": {
    "title": "Colossus SDK Example",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8099/v1"
    }
  ],
  "paths": {
    "/status/{service}": {
      "get": {
        "operationId": "getStatus",
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded fixture status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "service",
                    "status"
                  ],
                  "properties": {
                    "service": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "green"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
