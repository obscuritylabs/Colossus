{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Colossus Desktop setup manifest",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": 1 } } },
    "then": { "properties": { "providers": { "minProperties": 1 } } }
  }],
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "providers"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "descriptionMarkdown": {
      "type": "string",
      "maxLength": 16384
    },
    "caBundle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^certificates/[A-Za-z0-9_.-]+\\.pem$"
    },
    "providers": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "descriptionMarkdown": {
            "type": "string",
            "maxLength": 16384
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^assets/[A-Za-z0-9_.-]+\\.png$"
          },
          "darkIcon": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^assets/[A-Za-z0-9_.-]+\\.png$"
          }
        }
      }
    }
  }
}
