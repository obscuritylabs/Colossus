#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf 'prepare-desktop-binaries: usage: %s debug|release\n' "$0" >&2
    exit 1
fi

case "$1" in
    debug | release) ;;
    *)
        printf 'prepare-desktop-binaries: profile must be debug or release\n' >&2
        exit 1
        ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
cd "$repository"
exec cargo xtask desktop prepare --profile "$1"
