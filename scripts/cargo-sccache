#!/bin/sh
set -eu

fail() {
    printf 'cargo-sccache: %s\n' "$*" >&2
    exit 1
}

cargo_bin=$(command -v cargo) || fail "cargo is not installed or not on PATH"
sccache_bin=$(command -v sccache) || \
    fail "sccache is not installed or not on PATH; install it or run cargo directly"

export RUSTC_WRAPPER="$sccache_bin"

exec "$cargo_bin" "$@"
