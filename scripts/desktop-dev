#!/bin/sh
set -eu

fail() {
    printf 'desktop-dev: %s\n' "$*" >&2
    exit 1
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
desktop="$repository/apps/desktop"
development_custody=false
dictation=false
browser_preview=false
for argument in "$@"; do
    case "$argument" in
        --dev-credentials) [ "$development_custody" = false ] || fail "duplicate --dev-credentials"; development_custody=true ;;
        --browser-preview) [ "$browser_preview" = false ] || fail "duplicate --browser-preview"; browser_preview=true ;;
        --dictation) [ "$dictation" = false ] || fail "duplicate --dictation"; dictation=true ;;
        *) fail "usage: scripts/desktop-dev [--dev-credentials] [--dictation] [--browser-preview]" ;;
    esac
done
if [ "$development_custody" = true ]; then
    [ -n "${COLOSSUS_HOME:-}" ] || fail "--dev-credentials requires an explicit private COLOSSUS_HOME outside the workspace"
    case "$COLOSSUS_HOME" in /*) ;; *) fail "COLOSSUS_HOME must be absolute" ;; esac
fi

command -v npm >/dev/null 2>&1 || fail "npm is not installed or not on PATH"
command -v cargo >/dev/null 2>&1 || fail "cargo is not installed or not on PATH"
command -v node >/dev/null 2>&1 || fail "node is not installed or not on PATH"

connection="$desktop/src-tauri/connection.local.json"
if [ -f "$connection" ]; then
    node -e '
const fs = require("fs");
const path = process.argv[1];
try {
  const value = JSON.parse(fs.readFileSync(path, "utf8"));
  const instance = typeof value.instanceId === "string" ? value.instanceId.replaceAll("-", "") : "";
  const fingerprint = typeof value.certificateSha256 === "string" ? value.certificateSha256 : "";
  if (!/^[0-9a-fA-F]{32}$/.test(instance) || /^0+$/.test(instance) || !/^[0-9a-fA-F]{64}$/.test(fingerprint) || /^0+$/.test(fingerprint)) {
    process.exitCode = 1;
  }
} catch {
  process.exitCode = 1;
}
' "$connection" || fail "connection.local.json has invalid External target trust values; remove it to use Managed Local only, or map enrollment instance_id and certificate_sha256 into it"
fi

cd "$desktop"
node "$script_dir/development-launch.mjs" -- npm ci --ignore-scripts

set -- dev
if [ "$browser_preview" = true ]; then set -- "$@" --features browser-preview; fi
set -- "$@" -- --locked

if [ "$development_custody" = true ]; then
    cd "$repository"
    node "$script_dir/development-launch.mjs" -- cargo xtask desktop prepare --profile debug
    target=$(rustc -vV | sed -n 's/^host: //p')
    cli="$desktop/src-tauri/binaries/colossus-$target"
    [ -x "$cli" ] || fail "prepared development CLI is unavailable"
    cd "$desktop"
    exec node "$script_dir/development-launch.mjs" --authority-home "$COLOSSUS_HOME" --workspace "$repository" --cli "$cli" -- npm run tauri -- "$@"
fi

if [ "$browser_preview" = true ]; then
    node "$script_dir/development-launch.mjs" -- npm run prepare:sidecars:dev
    exec node "$script_dir/development-launch.mjs" -- npm run tauri -- "$@"
fi

if [ "$dictation" = true ]; then command=tauri:dev:dictation; else command=tauri:dev; fi
exec node "$script_dir/development-launch.mjs" -- npm run "$command"
