{
  "name": "@colossus/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "npm run format:check && npm run build && npm test",
    "format:check": "prettier --check src tests *.json *.ts *.html *.md src-tauri/tauri.conf.json ../control-plane-client",
    "format": "prettier --write .",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@colossus/control-plane-client": "file:../control-plane-client",
    "@colossus/ui": "file:../ui",
    "@tabler/icons-react": "3.45.0",
    "@tauri-apps/api": "2.12.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
