{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-chat",
  "description": "Only the main bundled WebView may use the narrow Colossus chat commands.",
  "windows": ["main"],
  "permissions": [
    "allow-desktop-release-channel",
    "allow-desktop-release-metadata",
    "allow-export-diagnostics",
    "allow-initialize-desktop",
    "allow-desktop-status",
    "allow-codex-auth-status",
    "allow-codex-auth-login",
    "allow-codex-auth-logout",
    "allow-import-ca-bundle",
    "allow-remove-ca-bundle",
    "allow-add-external-target",
    "allow-remove-external-target",
    "allow-choose-workspace",
    "allow-create-space",
    "allow-list-spaces",
    "allow-select-space",
    "allow-rename-space",
    "allow-archive-space",
    "allow-restore-space",
    "allow-search-space-threads",
    "allow-get-managed-configuration",
    "allow-save-global-defaults",
    "allow-upsert-global-mcp-server",
    "allow-save-space-configuration",
    "allow-apply-space-configuration",
    "allow-create-managed-credential",
    "allow-rotate-managed-credential",
    "allow-delete-managed-credential",
    "allow-configure-managed-runtime",
    "allow-apply-managed-model-configuration",
    "allow-run-managed-self-test",
    "allow-restart-managed-runtime",
    "allow-get-thread-delegate",
    "allow-get-session-map",
    "allow-select-target",
    "allow-set-approval-mode",
    "allow-set-terminal-enabled",
    "allow-connect-colossus",
    "allow-connection-status",
    "allow-create-run",
    "allow-choose-run-attachment",
    "allow-read-artifact-content",
    "allow-get-run",
    "allow-list-runs",
    "allow-list-asides",
    "allow-watch-run",
    "allow-cancel-run",
    "allow-archive-thread",
    "allow-restore-thread",
    "allow-respond-interaction",
    "allow-list-workspace-directory",
    "allow-read-workspace-file",
    "allow-show-terminal-window",
    "allow-check-desktop-update",
    "allow-install-desktop-update"
  ]
}
