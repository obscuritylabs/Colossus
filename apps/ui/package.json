{
  "name": "@colossus/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./styles/*"
  ],
  "license": "Apache-2.0",
  "files": [
    "src",
    "styles",
    "assets"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./styles/*",
    "./assets/*": "./assets/*",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./data-table": "./src/components/DataTable.tsx",
    "./conversation": "./src/conversation.ts",
    "./charts": "./src/charts.ts",
    "./automations": "./src/automations.ts",
    "./agent-inbox": "./src/agent-inbox.tsx",
    "./automations/*": "./src/automations/*.tsx",
    "./automations/types": "./src/automations/types.ts",
    "./automations/workflow-graph": "./src/automations/workflow-graph.ts",
    "./automations/schedule-examples": "./src/automations/schedule-examples.ts",
    "./session/*": "./src/session/*.tsx",
    "./session/types": "./src/session/types.ts",
    "./session/selectors": "./src/session/selectors.ts",
    "./session/sources": "./src/session/sources.ts",
    "./appearance": "./src/components/AppearanceSettings.tsx"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "dependencies": {
    "@tabler/icons-react": "3.45.0",
    "@tanstack/react-table": "9.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "recharts": "3.10.1",
    "react-is": "19.2.7",
    "@radix-ui/react-collapsible": "1.1.21",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "react-resizable-panels": "4.14.3",
    "@xyflow/react": "12.11.3"
  }
}
