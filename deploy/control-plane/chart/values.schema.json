{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Colossus Control Plane values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
            "maxLength": 63
          }
        },
        "databaseSecretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
          "maxLength": 63
        },
        "postgresAdminSecretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
          "maxLength": 63
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
      "maxLength": 63
    },
    "platform": {
      "type": "string",
      "enum": [
        "kubernetes",
        "openshift"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "browserHost": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
      "maxLength": 253
    },
    "connectorHost": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
      "maxLength": 253
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "string",
              "pattern": "^\\d+%$"
            }
          ]
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minDomains": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ingress-nginx",
            "istio",
            "gateway-api",
            "none"
          ]
        },
        "browserTlsSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
          "maxLength": 63
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "browserAnnotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "connectorAnnotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "istio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gateways": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "gatewayAPI": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "browserSectionName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "connectorSectionName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "tlsRouteApiVersion": {
              "type": "string",
              "enum": [
                "gateway.networking.k8s.io/v1",
                "gateway.networking.k8s.io/v1alpha2"
              ]
            }
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "sidecar",
            "ambient"
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sessionSeconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 28800
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "issuer": {
              "type": "string",
              "pattern": "^$|^https://[^\\s]+$"
            },
            "clientId": {
              "type": "string",
              "maxLength": 256
            },
            "clientSecret": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "secretKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._-]+$"
            }
          }
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "username": {
              "type": "string"
            },
            "oidcSubject": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string",
              "pattern": "^$|^[\\s\\S]{15,}$"
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "authKeyKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "bootstrapPasswordKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "authKey": {
              "type": "string",
              "pattern": "^$|^[a-fA-F0-9]{64}$"
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
          "maxLength": 63
        },
        "caCertificateKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "caPrivateKeyKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "serverCertificateKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "serverPrivateKeyKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "caCertificate": {
          "type": "string"
        },
        "caPrivateKey": {
          "type": "string"
        },
        "serverCertificate": {
          "type": "string"
        },
        "serverPrivateKey": {
          "type": "string"
        },
        "renewalRevision": {
          "type": "string"
        },
        "validityDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraIngress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$"
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "connectionTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "statementTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
              "maxLength": 63
            },
            "secretKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "url": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "webpki_roots",
                    "custom_ca"
                  ]
                },
                "existingSecret": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$|^$",
                  "maxLength": 63
                },
                "caKey": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._-]+$"
                },
                "caCertificate": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batchLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "deliveredOutboxRetentionSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "maxLength": 160
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "info",
            "warning",
            "danger"
          ]
        },
        "position": {
          "type": "string",
          "enum": [
            "top",
            "top_and_bottom"
          ]
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "postgres": {
      "type": "object",
      "description": "Values for the vendored CloudPirates PostgreSQL dependency. See its bundled README."
    }
  }
}
