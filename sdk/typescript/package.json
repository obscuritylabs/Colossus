{
  "name": "@obscuritylabs/colossus-sdk",
  "version": "0.10.9",
  "description": "Security-focused Node.js SDK for the Colossus public gRPC API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obscuritylabs/Colossus.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gen/*": {
      "types": "./dist/gen/*.d.ts",
      "import": "./dist/gen/*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepack": "../scripts/check-generated typescript && npm run build",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@grpc/grpc-js": "1.14.4"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "ts-proto": "2.12.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
