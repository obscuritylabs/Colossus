#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sdk_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
language=${1:-}
file_list=$(mktemp "${TMPDIR:-/tmp}/colossus-sdk-output-files.XXXXXX")
hash_list=$(mktemp "${TMPDIR:-/tmp}/colossus-sdk-output-hashes.XXXXXX")
trap 'rm -f "$file_list" "$hash_list"' EXIT HUP INT TERM

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "error: sha256sum or shasum is required" >&2
    exit 1
  fi
}

cd "$sdk_dir"
case "$language" in
  typescript)
    find typescript/src/gen -type f -name '*.ts' -print
    ;;
  python)
    find python/generated -type f \
      \( -name '*.py' -o -name '*.pyi' -o -name 'py.typed' \) -print
    ;;
  go)
    find go/gen -type f -name '*.go' -print
    ;;
  *)
    echo "error: expected language to be typescript, python, or go" >&2
    exit 1
    ;;
esac | LC_ALL=C sort >"$file_list"

if [ ! -s "$file_list" ]; then
  echo "error: no generated $language SDK files were found" >&2
  exit 1
fi

while IFS= read -r output; do
  printf '%s  %s\n' "$(hash_file "$output")" "${output#"$language/"}"
done <"$file_list" >"$hash_list"

hash_file "$hash_list"
