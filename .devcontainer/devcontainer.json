{
  "name": "Colossus",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "containerEnv": {
    "CC": "clang",
    "CXX": "clang++"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "dbaeumer.vscode-eslint",
        "ms-python.python",
        "golang.Go"
      ]
    }
  },
  "postCreateCommand": "mise trust && mise install --locked"
}
