# Version-control and local agent metadata are not image build inputs.
.git/
.github/
.githooks/
.agents/
.codex/

# Local runtime state and credentials must never enter the build context.
.colossus/
**/.env
**/.env.*
**/.aws/
**/.ssh/
**/.git-credentials
**/.netrc
**/.npmrc
**/.pypirc
**/.cargo/credentials
**/.cargo/credentials.toml

# Generated dependencies, build products, and tool caches.
**/target/
**/node_modules/
**/dist/
site/
output/
**/coverage/
**/playwright-report/
**/test-results/
**/.cache/
**/.tools/
**/.codegen/
**/.venv/
**/__pycache__/
**/.ruff_cache/
**/.mypy_cache/
**/.pytest_cache/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/gen/schemas/
apps/desktop/src-tauri/permissions/autogenerated/

# Editor and operating-system artifacts.
**/.DS_Store
**/*.log
**/*.tsbuildinfo
